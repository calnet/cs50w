{
	"name": "Capstone Fullstack",
	"dockerComposeFile": "../docker-compose.yml",
	"service": "fullstack",
	"workspaceFolder": "/app",
	"shutdownAction": "stopCompose",
	// Additional mounts for DevContainer
	"mounts": [
		"source=${localWorkspaceFolder}/frontend,target=/app/frontend,type=bind"
	],
	// Port forwarding with labels
	"forwardPorts": [
		3000,
		5173,
		8000
	],
	"portsAttributes": {
		"3000": {
			"label": "Frontend Dev Server",
			"onAutoForward": "notify"
		},
		"5173": {
			"label": "Vite Dev Server",
			"onAutoForward": "notify"
		},
		"8000": {
			"label": "Django Backend",
			"onAutoForward": "notify"
		}
	},
	// VS Code customizations
	"customizations": {
		"vscode": {
			"extensions": [
				// Python & Django
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-python.pylint",
				"ms-python.isort",
				"batisteo.vscode-django",
				"charliermarsh.ruff",
				// JavaScript/Frontend
				"ms-vscode.vscode-typescript-next",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss",
				"formulahendry.auto-rename-tag",
				// Git & Development
				"eamodio.gitlens",
				"ms-azuretools.vscode-docker",
				"ms-vscode.vscode-json",
				"christian-kohler.path-intellisense",
				"gruntfuggly.todo-tree",
				// API & Database
				"humao.rest-client",
				"qwtel.sqlite-viewer"
			],
			"settings": {
				// Python configuration
				"python.defaultInterpreterPath": "/app/py/bin/python",
				"python.terminal.activateEnvironment": false,
				"python.formatting.provider": "black",
				"python.linting.enabled": true,
				"python.linting.pylintEnabled": true,
				// Editor settings
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.organizeImports": true
				},
				"editor.rulers": [
					88,
					120
				],
				// File management
				"files.exclude": {
					"**/__pycache__": true,
					"**/node_modules": true,
					"**/.git": false,
					"**/dist": true,
					"**/build": true
				},
				// Terminal
				"terminal.integrated.defaultProfile.linux": "bash",
				"terminal.integrated.cwd": "/app"
			}
		}
	},
	// Container user
	"remoteUser": "appuser",
	// Lifecycle commands
	"postCreateCommand": "echo 'DevContainer ready for development!'",
	"postStartCommand": "echo 'Access your app at: http://localhost:8000'"
}