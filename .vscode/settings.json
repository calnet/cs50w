{
    "breadcrumbs.enabled": true,
    "cSpell.words": [
        "simplebar"
    ],
    "[django-html]": {
        "editor.quickSuggestions": {
            "comments": true,
            "other": true,
            "strings": true
        }
    },
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.addMissingImports": "explicit"
    },
    "editor.codeLens": false,
    "editor.colorDecorators": true,
    "editor.foldingHighlight": true,
    "editor.formatOnSave": true,
    "editor.hover.enabled": true,
    "editor.lightbulb.enabled": "on",
    "editor.occurrencesHighlight": "singleFile",
    "editor.parameterHints.enabled": true,
    "editor.quickSuggestions": {
        "comments": "on",
        "strings": "on",
        "other": "on"
    },
    "editor.renderWhitespace": "none",
    "editor.selectionHighlight": true,
    "editor.suggestOnTriggerCharacters": true,
    "editor.tabSize": 4,
    "editor.useTabStops": false,
    "emmet.includeLanguages": {
        "django-html": "html",
        "javascript": "javascriptreact",
        "typescript": "typescriptreact"
    },
    "extensions.closeExtensionDetailsOnViewChange": true,
    "git.autofetch": "all",
    "git.blame.editorDecoration.enabled": true,
    "git.confirmSync": false,
    "git.fetchOnPull": true,
    "git.followTagsWhenSync": true,
    "git.postCommitCommand": "sync",
    "git.timeline.showUncommitted": true,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "github.copilot.chat.languageContext.fix.typescript.enabled": false,
    "html.format.preserveNewLines": true,
    "javascript.suggest.enabled": true,
    "javascript.validate.enable": true,
    "prettier.printWidth": 105,
    "prettier.singleQuote": true,
    "prettier.tabWidth": 4,
    "python.analysis.typeCheckingMode": "basic",
    "python.testing.pytestArgs": [
        "backend"
    ],
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./capstone",
        "-p",
        "*test.py"
    ],
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "scm.diffDecorationsGutterPattern": {
        "added": true
    },
    "terminal.integrated.tabs.showActiveTerminal": "always",
    "terminal.integrated.tabStopWidth": 4,
    "workbench.colorTheme": "Shades of Purple (Super Dark)",
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.editor.enablePreview": true,
    "workbench.sideBar.location": "right",
    "workbench.secondarySideBar.defaultVisibility": "visible",
    "workbench.statusBar.visible": true,
    "workspaceExplorer.workspaceStorageDirectory": "/Users/calnet/Documents/workspaceStorage",
}